---
import fs from 'fs';
import path from 'path';

const bestDealsPath = path.resolve('../data/clark_best_deals.json');
let bestDeals = [];

if (fs.existsSync(bestDealsPath)) {
  bestDeals = JSON.parse(fs.readFileSync(bestDealsPath, 'utf-8'));
}

// Spotlight top #1 category winners
const topWinners = bestDeals.filter((d: any) => d.staff_pick_rank === 1).slice(0, 4);

function formatPrice(val: number) {
  if (val === undefined || val === null || isNaN(val)) return '0.00';
  return val % 1 === 0 ? val.toString() : val.toFixed(2);
}
---

{topWinners.length > 0 && (
  <section class="mb-10 p-6 bg-gradient-to-br from-indigo-950 to-slate-900 rounded-3xl text-white shadow-xl relative overflow-hidden">
    <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 relative z-10">
      <div>
        <div class="flex items-center gap-2 text-indigo-400 text-xs font-black uppercase tracking-wider mb-1">
          <span>⚡</span>
          <span>Curated Department Winners</span>
        </div>
        <h2 class="font-heading font-black text-2xl tracking-tight text-white">
          Staff Top Picks: #1 Hardware Deals
        </h2>
      </div>
      <a 
        href="/best-deals" 
        class="inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-xl transition-all shadow-md self-start sm:self-auto"
      >
        <span>View All {bestDeals.length} Staff Picks</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 relative z-10">
      {topWinners.map((deal: any) => (
        <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-4 flex flex-col justify-between hover:border-indigo-400/80 transition-all group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[9px] font-black uppercase tracking-wider bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded border border-indigo-400/30">
                #1 {deal.category_name}
              </span>
              <span class="text-xs font-black text-indigo-400">
                -{deal.discount_pct}%
              </span>
            </div>

            <div class="w-full aspect-video bg-slate-900/50 rounded-xl p-3 mb-3 flex items-center justify-center overflow-hidden">
              <img src={deal.image_url} alt={deal.title} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform" />
            </div>

            <h3 class="font-heading font-bold text-xs text-slate-200 line-clamp-2 leading-snug mb-2 group-hover:text-white transition-colors">
              {deal.title}
            </h3>
          </div>

          <div class="pt-3 border-t border-slate-700/60 flex items-center justify-between">
            <div>
              <div class="text-base font-heading font-black text-white leading-none">
                ${formatPrice(deal.current_price)}
              </div>
              <div class="text-[10px] text-indigo-400 font-bold mt-0.5">
                Save ${formatPrice(deal.savings)}
              </div>
            </div>

            <a 
              href={deal.affiliate_url} 
              target="_blank" 
              rel="nofollow noopener"
              class="px-3 py-1.5 bg-[#131921] hover:bg-slate-700 text-white text-[11px] font-bold rounded-lg transition-colors flex items-center gap-1"
            >
              <span>Buy</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
)}
