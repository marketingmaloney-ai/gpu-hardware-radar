---
// QuickViewDrawer component with honest Price Integrity Assessment
---

<div id="quickview-drawer-backdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>

<aside id="quickview-drawer" class="fixed top-0 right-0 bottom-0 w-full sm:w-[480px] bg-white z-50 shadow-2xl translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between overflow-y-auto">
  
  <!-- Header -->
  <div class="p-4 sm:p-6 border-b border-slate-200 flex items-center justify-between sticky top-0 bg-white/95 backdrop-blur-xs z-10">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Hardware Price Intelligence</span>
    </div>
    <button id="close-drawer-btn" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
      ✕
    </button>
  </div>

  <!-- Body Content -->
  <div class="p-6 space-y-6 flex-1">
    
    <!-- Image & Badges -->
    <div class="relative w-full aspect-video sm:aspect-square bg-slate-50 rounded-2xl p-6 flex items-center justify-center border border-slate-100 overflow-hidden">
      <img id="drawer-img" src="" alt="" class="max-h-full max-w-full object-contain" />
      <div id="drawer-badge" class="absolute top-3 left-3 bg-[#131921] text-indigo-400 text-xs font-black px-2.5 py-1 rounded-md shadow-xs"></div>
    </div>

    <!-- Title & Brand -->
    <div>
      <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">
        <span id="drawer-brand" class="text-slate-800 font-extrabold"></span>
        <span>•</span>
        <span id="drawer-category"></span>
      </div>
      <h2 id="drawer-title" class="font-heading font-black text-lg text-slate-900 leading-snug"></h2>
    </div>

    <!-- Price Integrity Assessment Box -->
    <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-4.5 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-900">Amazon Price Benchmark</span>
        <span id="drawer-radar-score" class="text-xs font-black bg-white text-indigo-600 px-2 py-0.5 rounded border border-indigo-200"></span>
      </div>

      <div class="flex items-baseline justify-between pt-1">
        <div>
          <div class="text-[11px] font-bold text-slate-500 uppercase">Live Buy-Box</div>
          <div id="drawer-live-price" class="font-heading font-black text-2xl text-slate-900"></div>
        </div>
        <div class="text-right">
          <div class="text-[11px] font-bold text-slate-500 uppercase">Regular MSRP</div>
          <div id="drawer-reg-price" class="font-heading font-bold text-sm text-slate-400 line-through"></div>
        </div>
        <div class="text-right">
          <div class="text-[11px] font-bold text-indigo-600 uppercase">Total Savings</div>
          <div id="drawer-savings" class="font-heading font-black text-base text-indigo-700"></div>
        </div>
      </div>

      <div class="text-xs text-slate-600 pt-2 border-t border-indigo-100/80 flex items-center justify-between">
        <span>Verified by Amazon Harvester:</span>
        <span id="drawer-mins-ago" class="font-bold text-slate-800"></span>
      </div>
    </div>

    <!-- Add-On / Bundle Incentive -->
    <div class="p-3.5 bg-slate-50 border border-slate-200/80 rounded-xl flex items-center justify-between text-xs">
      <div>
        <div class="font-bold text-slate-800">Anti-Static & Thermal Mod Bundle</div>
        <div class="text-slate-500 text-[11px]">Recommended thermal pads & cable ties (+15% cart value)</div>
      </div>
      <span class="text-indigo-600 font-bold text-xs">Included</span>
    </div>

  </div>

  <!-- Drawer Footer Action -->
  <div class="p-4 sm:p-6 border-t border-slate-200 bg-slate-50 space-y-3 sticky bottom-0">
    <a 
      id="drawer-amazon-cta" 
      href="#" 
      target="_blank" 
      rel="nofollow noopener"
      class="w-full bg-[#131921] hover:bg-slate-800 text-white font-heading font-black text-sm py-3.5 px-6 rounded-xl flex items-center justify-center gap-2 transition-all shadow-md hover:shadow-lg group"
    >
      <span>View Live Deal on Amazon</span>
      <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
    
    <div class="text-center text-[10px] text-slate-400">
      Eligible for Amazon Prime Free 2-Day Delivery & 30-Day Hassle-Free Returns.
    </div>
  </div>

</aside>

<script is:inline>
  function initDrawer() {
    const backdrop = document.getElementById('quickview-drawer-backdrop');
    const drawer = document.getElementById('quickview-drawer');
    const closeBtn = document.getElementById('close-drawer-btn');
    const cards = document.querySelectorAll('.deal-card-item');

    function formatPrice(val) {
      if (!val) return '0.00';
      const num = parseFloat(val);
      return num % 1 === 0 ? num.toString() : num.toFixed(2);
    }

    function openDrawer(data) {
      document.getElementById('drawer-img').src = data.image;
      document.getElementById('drawer-img').alt = data.title;
      document.getElementById('drawer-brand').innerText = '@' + data.brand.toLowerCase();
      document.getElementById('drawer-category').innerText = data.category;
      document.getElementById('drawer-title').innerText = data.title;
      document.getElementById('drawer-live-price').innerText = '$' + formatPrice(data.price);
      document.getElementById('drawer-reg-price').innerText = '$' + formatPrice(data.regprice);
      document.getElementById('drawer-savings').innerText = '$' + formatPrice(data.savings) + ' (' + data.discount + '% Off)';
      document.getElementById('drawer-radar-score').innerText = data.score + '/100 VALUE SCORE';
      document.getElementById('drawer-badge').innerText = data.badge;
      document.getElementById('drawer-mins-ago').innerText = data.mins + ' mins ago';
      document.getElementById('drawer-amazon-cta').href = data.affiliate;

      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      drawer.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }

    cards.forEach(card => {
      card.addEventListener('click', () => {
        openDrawer(card.dataset);
      });
    });

    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);
  }

  document.addEventListener('DOMContentLoaded', initDrawer);
</script>
