---
interface Props {
  deal: {
    asin: string;
    slug: string;
    title: string;
    brand: string;
    category: string;
    category_name: string;
    current_price: number;
    regular_price: number;
    savings: number;
    discount_pct: number;
    rating: number;
    review_count: number;
    image_url: string;
    radar_score: number;
    verified_mins_ago: number;
    badge_tier: string;
    badge_label: string;
    badge_color: string;
    affiliate_url: string;
  };
}

const { deal } = Astro.props;

function formatPrice(val: number) {
  if (val === undefined || val === null || isNaN(val)) return '0.00';
  return val % 1 === 0 ? val.toString() : val.toFixed(2);
}
---

<div 
  class="group relative flex flex-col bg-white rounded-2xl border border-slate-200/80 hover:border-indigo-400/80 hover:shadow-xl transition-all duration-300 overflow-hidden cursor-pointer deal-card-item"
  data-asin={deal.asin}
  data-slug={deal.slug}
  data-title={deal.title}
  data-brand={deal.brand}
  data-category={deal.category}
  data-price={deal.current_price}
  data-regprice={deal.regular_price}
  data-savings={deal.savings}
  data-discount={deal.discount_pct}
  data-rating={deal.rating}
  data-reviews={deal.review_count}
  data-image={deal.image_url}
  data-affiliate={deal.affiliate_url}
  data-score={deal.radar_score}
  data-badge={deal.badge_label}
  data-mins={deal.verified_mins_ago}
>
  <!-- Top Badges Row -->
  <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between z-10 pointer-events-none">
    <!-- Left Pill: Amazon + Discount -->
    <div class="flex items-center gap-1 bg-[#131921]/95 text-white px-2 py-0.5 rounded-md text-[10px] font-black shadow-xs tracking-tight">
      <span class="text-[8px] uppercase tracking-wider text-slate-300">AMAZON</span>
      {deal.discount_pct > 0 ? (
        <span class="text-indigo-400">-{deal.discount_pct}%</span>
      ) : (
        <span class="text-slate-300">MSRP</span>
      )}
    </div>

    <!-- Right Pill: Radar Score -->
    <div class="bg-[#131921]/95 text-indigo-400 px-1.5 py-0.5 rounded-md text-[10px] font-black shadow-xs">
      {deal.radar_score}/100
    </div>
  </div>

  <!-- Product Image Container -->
  <div class="w-full aspect-square bg-slate-50/50 p-6 flex items-center justify-center relative overflow-hidden group-hover:bg-slate-50 transition-colors">
    <img 
      src={deal.image_url} 
      alt={deal.title} 
      loading="lazy"
      class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
    />
  </div>

  <!-- Card Body -->
  <div class="p-3.5 flex flex-col flex-1 justify-between bg-white">
    <div>
      <!-- Brand & Category -->
      <div class="flex items-center gap-1.5 mb-1 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
        <span class="text-slate-700">@{deal.brand.toLowerCase()}</span>
        <span>•</span>
        <span class="truncate">{deal.category_name}</span>
      </div>

      <!-- Title (2 lines clamp) -->
      <h3 class="font-heading font-bold text-xs text-slate-800 line-clamp-2 leading-snug group-hover:text-indigo-600 transition-colors min-h-[2rem]">
        {deal.title}
      </h3>
    </div>

    <!-- Pricing Footer -->
    <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-end justify-between">
      <div>
        <div class="flex items-baseline gap-1.5">
          <span class="font-heading font-black text-base text-slate-900 leading-none">
            ${formatPrice(deal.current_price)}
          </span>
          {deal.savings > 0 && (
            <span class="text-[11px] text-slate-400 line-through font-medium leading-none">
              ${formatPrice(deal.regular_price)}
            </span>
          )}
        </div>
        {deal.savings > 0 ? (
          <div class="text-[10px] font-extrabold text-indigo-700 mt-1 flex items-center gap-1">
            <span class="bg-indigo-50 px-1.5 py-0.2 rounded border border-indigo-200/60">
              Save ${formatPrice(deal.savings)}
            </span>
          </div>
        ) : (
          <div class="text-[10px] font-bold text-slate-400 mt-1">
            MSRP Benchmark
          </div>
        )}
      </div>

      <!-- Rating Pill -->
      <div class="flex items-center gap-1 text-[11px] font-bold text-slate-600 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-100">
        <span class="text-amber-500">★</span>
        <span>{deal.rating}</span>
      </div>
    </div>
  </div>
</div>
