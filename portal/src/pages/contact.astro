---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us & Deal Operations | Price Drop Radar"
  description="Contact the PriceDropRadar operations and editorial team regarding deal inquiries, price drops, or feedback."
>
  <div class="max-w-2xl mx-auto py-12 px-4 sm:px-6">
    <div class="mb-8">
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-slate-700 inline-flex items-center gap-1 mb-3">
        <span>←</span>
        <span>Back to Explore Deals</span>
      </a>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight mb-2">Contact Our Operations Team</h1>
      <p class="text-sm text-slate-600">
        Have a question, editorial feedback, or noticed an expired price before our sync engine updated? Let us know below.
      </p>
    </div>

    <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
      
      <!-- Success Message Banner -->
      <div id="contact-success" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-900 p-4 rounded-xl text-sm space-y-1">
        <div class="font-bold">Thank you! Your message has been received.</div>
        <div class="text-xs text-emerald-700">Our operations team has received your submission and will review it promptly.</div>
      </div>

      <!-- Error Message Banner -->
      <div id="contact-error" class="hidden bg-rose-50 border border-rose-200 text-rose-900 p-4 rounded-xl text-xs">
        There was an error dispatching your message. Please try again or reach out directly.
      </div>

      <!-- Contact Form -->
      <form id="contact-form" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Name</label>
          <input 
            type="text" 
            name="name" 
            id="sender-name"
            required 
            placeholder="Jane Doe" 
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" 
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email Address</label>
          <input 
            type="email" 
            name="email" 
            id="sender-email"
            required 
            placeholder="jane@example.com" 
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none" 
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Topic</label>
          <select 
            name="topic" 
            id="topic-select"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white"
          >
            <option value="Deal Inquiry">Deal Inquiry / Product Question</option>
            <option value="Expired Price Report">Expired Price / Broken Link Report</option>
            <option value="Editorial Suggestion">Editorial Suggestion</option>
            <option value="Partnership / General">Partnership / General Feedback</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Message</label>
          <textarea 
            name="message" 
            id="sender-message"
            rows="4" 
            required 
            placeholder="Tell us what you need or provide the product link..." 
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full bg-[#131921] hover:bg-emerald-600 text-white font-bold py-3.5 rounded-xl text-xs transition-all duration-150 shadow-sm flex items-center justify-center gap-2"
        >
          <span id="btn-text">Send Message to Operations</span>
          <span id="btn-spinner" class="hidden animate-spin rounded-full h-3.5 w-3.5 border-b-2 border-white"></span>
        </button>
      </form>

      <div class="pt-6 border-t border-slate-100 text-center text-xs text-slate-400">
        Direct Inquiries: <span class="font-medium text-slate-600">support@price-drop-radar.com</span> • PriceDropRadar Operations Team
      </div>
    </div>
  </div>

  <!-- Form Submission Script -->
  <script is:inline>
    const form = document.getElementById('contact-form');
    const successDiv = document.getElementById('contact-success');
    const errorDiv = document.getElementById('contact-error');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // UI Loading state
        btnText.textContent = "Sending...";
        btnSpinner.classList.remove('hidden');
        submitBtn.disabled = true;
        errorDiv.classList.add('hidden');

        const payload = {
          name: document.getElementById('sender-name').value.trim(),
          email: document.getElementById('sender-email').value.trim(),
          topic: document.getElementById('topic-select').value,
          message: document.getElementById('sender-message').value.trim()
        };

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            form.classList.add('hidden');
            successDiv.classList.remove('hidden');
          } else {
            errorDiv.classList.remove('hidden');
            btnText.textContent = "Send Message to Operations";
            btnSpinner.classList.add('hidden');
            submitBtn.disabled = false;
          }
        } catch (err) {
          console.error("Form error:", err);
          errorDiv.classList.remove('hidden');
          btnText.textContent = "Send Message to Operations";
          btnSpinner.classList.add('hidden');
          submitBtn.disabled = false;
        }
      });
    }
  </script>
</Layout>
