---
import Layout from '../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

export async function getStaticPaths() {
  const dealsPath = path.resolve('../data/deals.json');
  let deals = [];
  if (fs.existsSync(dealsPath)) {
    deals = JSON.parse(fs.readFileSync(dealsPath, 'utf-8'));
  }

  return deals.map((deal: any) => ({
    params: { slug: deal.slug },
    props: { deal }
  }));
}

const { deal } = Astro.props;

function formatPrice(val: number) {
  if (val === undefined || val === null || isNaN(val)) return '0.00';
  return val % 1 === 0 ? val.toString() : val.toFixed(2);
}

// Helper to ensure Schema.org Product name adheres to Google's strict <= 150 char limit
function formatSchemaName(title: string, maxLen = 140): string {
  if (!title) return 'Product';
  const cleaned = title.replace(/\s+/g, ' ').trim();
  if (cleaned.length <= maxLen) return cleaned;
  const truncated = cleaned.slice(0, maxLen);
  const lastSpace = truncated.lastIndexOf(' ');
  return (lastSpace > 30 ? truncated.slice(0, lastSpace) : truncated).trim() + '...';
}

const canonicalImage = deal.image_url.startsWith('http') 
  ? deal.image_url 
  : `https://gpu-hardware-radar.pages.dev${deal.image_url}`;

// Schema.org Product markup for Google Rich Snippets & Merchant Listings
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": formatSchemaName(deal.title, 140),
  "image": canonicalImage,
  "description": (deal.seo && deal.seo.meta_description) || deal.title || "Verified live GPU and PC hardware deal.",
  "sku": deal.asin,
  "mpn": deal.asin,
  "brand": {
    "@type": "Brand",
    "name": deal.brand || "PC Hardware"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": (deal.rating || 4.7).toString(),
    "reviewCount": (deal.review_count || 100).toString(),
    "bestRating": "5",
    "worstRating": "1"
  },
  "offers": {
    "@type": "Offer",
    "price": deal.current_price.toString(),
    "priceCurrency": "USD",
    "validFrom": "2026-01-01",
    "priceValidUntil": "2026-12-31",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "url": `https://gpu-hardware-radar.pages.dev/deals/${deal.slug}`,
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "US",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0.00",
        "currency": "USD"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "US"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 1,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 3,
          "unitCode": "DAY"
        }
      }
    }
  }
};
---

<Layout 
  title={`${deal.title} - Save $${formatPrice(deal.savings)} (${deal.discount_pct}% Off)`} 
  description={deal.seo?.meta_description} 
  image={canonicalImage}
  schema={productSchema}
>
  
  <div class="max-w-[1080px] mx-auto px-4 sm:px-6 py-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 mb-6">
      <a href="/" class="hover:text-slate-800">Home</a>
      <span>/</span>
      <a href={`/category/${deal.category}`} class="hover:text-slate-800">{deal.category_name}</a>
      <span>/</span>
      <span class="text-indigo-600 truncate">{deal.brand}</span>
    </nav>

    <div class="bg-white border border-slate-200/80 rounded-3xl p-6 sm:p-10 shadow-sm grid grid-cols-1 md:grid-cols-2 gap-10">
      
      <!-- Product Image Container -->
      <div class="aspect-square bg-slate-50 rounded-2xl p-8 flex items-center justify-center relative border border-slate-100 overflow-hidden">
        <img src={deal.image_url} alt={deal.title} class="max-h-full max-w-full object-contain" />
        <div class="absolute top-4 left-4 bg-[#131921] text-indigo-400 font-heading font-black text-xs px-3 py-1 rounded-lg shadow-xs">
          {deal.badge_label}
        </div>
      </div>

      <!-- Details Column -->
      <div class="flex flex-col justify-between space-y-6">
        <div>
          <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
            @{deal.brand.toLowerCase()} • {deal.rating}★ ({deal.review_count.toLocaleString()} customer ratings)
          </div>
          <h1 class="font-heading font-black text-2xl sm:text-3xl text-slate-900 leading-snug">
            {deal.title}
          </h1>

          <!-- Price Integrity Benchmark Box -->
          <div class="bg-indigo-50/70 border border-indigo-100 rounded-2xl p-5 mt-6 space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-900">Amazon Price Benchmark</span>
              <span class="text-xs font-black bg-white text-indigo-600 px-2 py-0.5 rounded border border-indigo-200">{deal.radar_score}/100 Score</span>
            </div>

            <div class="flex items-baseline justify-between pt-1">
              <div>
                <div class="text-[11px] font-bold text-slate-500 uppercase">Live Buy-Box</div>
                <div class="font-heading font-black text-3xl text-slate-900">${formatPrice(deal.current_price)}</div>
              </div>
              <div class="text-right">
                <div class="text-[11px] font-bold text-slate-500 uppercase">Regular MSRP</div>
                <div class="font-heading font-bold text-base text-slate-400 line-through">${formatPrice(deal.regular_price)}</div>
              </div>
              <div class="text-right">
                <div class="text-[11px] font-bold text-indigo-600 uppercase">Total Discount</div>
                <div class="font-heading font-black text-lg text-indigo-700">Save ${formatPrice(deal.savings)} ({deal.discount_pct}% Off)</div>
              </div>
            </div>

            <div class="text-xs text-slate-600 pt-2 border-t border-indigo-100/80 flex items-center justify-between">
              <span>Verified Live by Radar Daemon:</span>
              <span class="font-bold text-slate-800">{deal.verified_mins_ago} mins ago</span>
            </div>
          </div>

          <!-- Product Highlights -->
          <div class="mt-6 space-y-2 text-xs text-slate-600">
            <div class="font-bold text-slate-800 uppercase text-[11px]">Hardware Verification:</div>
            <ul class="list-disc pl-4 space-y-1 text-slate-600">
              <li>100% Genuine component with full manufacturer warranty.</li>
              <li>Eligible for Amazon Prime Free 2-Day Shipping & 30-Day Returns.</li>
              <li>Verified active inventory in Amazon US Fulfillment Centers.</li>
            </ul>
          </div>
        </div>

        <!-- Buy Action Button -->
        <div class="pt-6 border-t border-slate-100 space-y-3">
          <a 
            href={deal.affiliate_url}
            target="_blank"
            rel="nofollow noopener"
            class="w-full bg-[#131921] hover:bg-slate-800 text-white font-heading font-black text-base py-4 px-8 rounded-2xl flex items-center justify-center gap-2 transition-all shadow-lg hover:shadow-xl group"
          >
            <span>View Live Deal on Amazon</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <div class="text-center text-[11px] text-slate-400">
            Prices and availability subject to change. As an Amazon Associate, we earn from qualifying purchases.
          </div>
        </div>

      </div>

    </div>

  </div>

</Layout>
